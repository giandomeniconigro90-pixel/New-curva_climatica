<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.climasense">

    <!-- PERMESSI AGGIUNTI PER IL METEO / GEOLOCALIZZAZIONE -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- (Se hai altri uses-permission, lasciali qui sopra o sotto, non cambia) -->

    <application
        android:name="${applicationName}"
        android:label="climasense"
        android:icon="@mipmap/ic_launcher">

        <!-- Mantieni eventuali meta-data o activity che avevi già -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Questa intent-filter è quella classica Flutter -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Necessario per embedding v2 di Flutter -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

</manifest>
